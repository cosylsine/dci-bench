{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dci-trajectory-v1",
  "title": "DCI-Bench Phase 4 sample trajectory",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "run_id", "task", "query_id", "started_at", "ended_at", "events"],
  "properties": {"schema_version": {"const": "dci-trajectory-v1"}, "run_id": {"type": "string", "minLength": 1}, "task": {"type": "string", "minLength": 1}, "query_id": {"type": "string", "minLength": 1}, "started_at": {"type": ["string", "null"]}, "ended_at": {"type": ["string", "null"]}, "events": {"type": "array"}, "messages": {"type": "array"}, "usage_by_turn": {"type": "array"}, "failure": {"type": ["object", "null"]}}
}
