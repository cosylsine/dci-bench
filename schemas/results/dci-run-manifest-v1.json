{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dci-run-manifest-v1",
  "title": "DCI-Bench Phase 4 run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "model_key", "task", "created_at", "status", "run_fingerprint", "query_ids", "metric_ks", "benchmark_contract", "model", "backend", "data", "code", "budgets"],
  "properties": {
    "schema_version": {"const": "dci-run-manifest-v1"}, "run_id": {"type": "string", "minLength": 1}, "model_key": {"type": "string", "minLength": 1}, "task": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "minLength": 1}, "status": {"type": "string", "minLength": 1}, "run_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "query_ids": {"type": "array", "items": {"type": "string"}}, "metric_ks": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}, "uniqueItems": true}, "benchmark_contract": {}, "model": {"type": "object"}, "backend": {"type": "object"}, "data": {"type": "object"}, "code": {"type": "object"}, "budgets": {"type": "object", "required": ["max_total_model_tokens"], "additionalProperties": false, "properties": {"max_total_model_tokens": {"type": "integer", "minimum": 0}}}
  }
}
