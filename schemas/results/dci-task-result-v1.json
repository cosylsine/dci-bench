{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dci-task-result-v1",
  "title": "DCI-Bench Phase 4 task result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "task", "query_ids", "metric_ks", "counts", "failure_rate", "metrics", "usage", "timing", "model", "backend", "data", "code", "samples", "inspect_log", "integrity"],
  "properties": {
    "schema_version": {"const": "dci-task-result-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "query_ids": {"type": "array", "items": {"type": "string"}},
    "metric_ks": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
    "counts": {"type": "object", "required": ["planned", "started", "completed", "valid", "invalid", "failure_counts"], "additionalProperties": false, "properties": {"planned": {"type": "integer", "minimum": 0}, "started": {"type": "integer", "minimum": 0}, "completed": {"type": "integer", "minimum": 0}, "valid": {"type": "integer", "minimum": 0}, "invalid": {"type": "integer", "minimum": 0}, "failure_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}}},
    "planned": {"type": "integer", "minimum": 0}, "started": {"type": "integer", "minimum": 0}, "completed": {"type": "integer", "minimum": 0}, "valid": {"type": "integer", "minimum": 0}, "invalid": {"type": "integer", "minimum": 0},
    "failure_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "metrics": {"type": "object", "required": ["macro", "valid_only"], "additionalProperties": false, "properties": {"macro": {"type": "object", "additionalProperties": {"$ref": "#/$defs/metric_stats"}}, "valid_only": {"type": "object", "additionalProperties": {"$ref": "#/$defs/metric_stats"}}}},
    "usage": {"type": "object", "additionalProperties": {"$ref": "#/$defs/availability_stats"}},
    "timing": {"type": "object", "required": ["wall_time_seconds", "working_time_seconds", "evaluation_elapsed_seconds", "launcher_preflight_seconds"], "additionalProperties": true, "properties": {"wall_time_seconds": {"$ref": "#/$defs/availability_stats"}, "working_time_seconds": {"$ref": "#/$defs/availability_stats"}, "evaluation_elapsed_seconds": {"type": ["number", "null"], "minimum": 0}, "launcher_preflight_seconds": {"type": ["number", "null"], "minimum": 0}}},
    "model": {"type": "object"}, "backend": {"type": "object"}, "data": {"type": "object"}, "code": {"type": "object"},
    "samples": {"type": "array", "items": {"$ref": "#/$defs/sample_index"}},
    "inspect_log": {"type": "object"}, "integrity": {"type": "object"}
  },
  "$defs": {
    "metric_stats": {"type": "object", "required": ["count", "mean", "population_stddev", "min", "p50", "p95", "max"], "additionalProperties": false, "properties": {"count": {"type": "integer", "minimum": 0}, "mean": {"type": ["number", "null"]}, "population_stddev": {"type": ["number", "null"], "minimum": 0}, "min": {"type": ["number", "null"]}, "p50": {"type": ["number", "null"]}, "p95": {"type": ["number", "null"]}, "max": {"type": ["number", "null"]}}},
    "availability_stats": {"type": "object", "required": ["available_count", "missing_count", "sum", "mean", "min", "p50", "p95", "max"], "additionalProperties": false, "properties": {"available_count": {"type": "integer", "minimum": 0}, "missing_count": {"type": "integer", "minimum": 0}, "sum": {"type": ["number", "null"]}, "mean": {"type": ["number", "null"]}, "min": {"type": ["number", "null"]}, "p50": {"type": ["number", "null"]}, "p95": {"type": ["number", "null"]}, "max": {"type": ["number", "null"]}}},
    "sample_index": {"type": "object", "required": ["query_id", "status", "valid_output", "result", "trace"], "additionalProperties": false, "properties": {"query_id": {"type": "string"}, "status": {"type": "string"}, "valid_output": {"type": "boolean"}, "result": {"$ref": "#/$defs/artifact_ref"}, "trace": {"$ref": "#/$defs/artifact_ref_nullable"}}},
    "artifact_ref": {"type": "object", "required": ["path", "sha256"], "additionalProperties": false, "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "artifact_ref_nullable": {"type": "object", "required": ["path", "sha256"], "additionalProperties": false, "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}}
  }
}
