{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dci-sample-result-v1",
  "title": "DCI-Bench Phase 4 sample result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "task", "query_id", "query_sha256", "status", "valid_output", "failure", "ranked_doc_ids", "metric_ks", "metrics", "usage", "timing", "execution", "security", "artifacts", "provenance"],
  "properties": {
    "schema_version": {"const": "dci-sample-result-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "query_id": {"type": "string", "minLength": 1},
    "query_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"type": "string", "minLength": 1},
    "valid_output": {"type": "boolean"},
    "failure": {
      "type": ["object", "null"],
      "required": ["kind", "message"],
      "properties": {"kind": {"type": "string", "enum": ["timeout", "token_limit", "invalid_json", "tool_failure", "context_overflow", "agent_error", "infrastructure_error", "usage_unavailable", "other"]}, "message": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "ranked_doc_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "metric_ks": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
    "metrics": {"type": "object", "additionalProperties": {"type": "number"}},
    "usage": {"$ref": "#/$defs/usage"},
    "timing": {"$ref": "#/$defs/timing"},
    "execution": {"type": "object", "required": ["agent_steps", "tool_calls", "model_calls", "repair_attempts", "repair_reasons"], "additionalProperties": false, "properties": {"agent_steps": {"type": "integer", "minimum": 0}, "tool_calls": {"type": "integer", "minimum": 0}, "model_calls": {"type": "integer", "minimum": 0}, "repair_attempts": {"type": "integer", "minimum": 0}, "repair_reasons": {"type": "array", "items": {"type": "string"}}}},
    "security": {"type": "object", "required": ["inspect_sandbox", "tool_sandbox"], "additionalProperties": false, "properties": {"inspect_sandbox": {"const": "local"}, "tool_sandbox": {"const": "bubblewrap"}}},
    "artifacts": {"type": "object", "additionalProperties": {"$ref": "#/$defs/artifact"}},
    "provenance": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "artifact": {"type": "object", "required": ["path", "sha256"], "additionalProperties": true, "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size_bytes": {"type": "integer", "minimum": 0}}},
    "usage": {"type": "object", "required": ["available", "input_tokens", "output_tokens", "total_tokens", "cache_read_tokens", "cache_write_tokens", "by_model"], "additionalProperties": false, "properties": {"available": {"type": "boolean"}, "input_tokens": {"type": ["integer", "null"], "minimum": 0}, "output_tokens": {"type": ["integer", "null"], "minimum": 0}, "total_tokens": {"type": ["integer", "null"], "minimum": 0}, "cache_read_tokens": {"type": ["integer", "null"], "minimum": 0}, "cache_write_tokens": {"type": ["integer", "null"], "minimum": 0}, "by_model": {"type": "object", "additionalProperties": {"$ref": "#/$defs/usage"}}}},
    "timing": {"type": "object", "required": ["started_at", "ended_at", "wall_time_seconds", "working_time_seconds"], "additionalProperties": false, "properties": {"started_at": {"type": ["string", "null"]}, "ended_at": {"type": ["string", "null"]}, "wall_time_seconds": {"type": ["number", "null"], "minimum": 0}, "working_time_seconds": {"type": ["number", "null"], "minimum": 0}}}
  },
  "allOf": [
    {"if": {"properties": {"valid_output": {"const": true}}}, "then": {"properties": {"failure": {"type": "null"}, "usage": {"properties": {"available": {"const": true}, "input_tokens": {"type": "integer"}, "output_tokens": {"type": "integer"}, "total_tokens": {"type": "integer"}}}, "timing": {"properties": {"wall_time_seconds": {"type": "number"}, "working_time_seconds": {"type": "number"}}}}}}
  ]
}
